// SLURM executor profile for the HPC.
// Activate with `-profile slurm,singularity`.

process {
    executor = 'slurm'
    queue    = 'main'

    // Default per-process resources
    cpus   = { 4 * task.attempt }
    memory = { 16.GB * task.attempt }
    time   = { 4.h * task.attempt }

    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 16 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel: 'process_long' {
        time   = { 24.h * task.attempt }
    }

    // Job-array submission for heavy per-sample processes. Mirrors the
    // approach used in tpall/DRAM. With many samples, this collapses N
    // sbatches into one array of N tasks for fair-share priority. Set
    // params.array_size = 0 to disable (e.g. for local runs).
    withName: 'GENOMAD|CHECKV|COVERM' {
        array = params.array_size
    }
}

executor {
    queueSize       = params.queue_size
    submitRateLimit = '20 sec'
}
