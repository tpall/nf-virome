manifest {
    name            = 'nf-virome'
    author          = 'Taavi Päll'
    description     = 'Generic viral identification, clustering, quantification, and host coupling'
    nextflowVersion = '>=23.10'
    version         = '0.1.0'
}

params {
    // Inputs
    samplesheet     = null
    outdir          = 'results'

    // Identification thresholds
    min_length      = 5000
    keep_quality    = 'Medium-quality,High-quality,Complete'

    // Clustering thresholds (MIUViG: 95% ANI, 85% AF on shorter sequence)
    votu_min_ani    = 95.0
    votu_min_af     = 85.0

    // Quantification (CoverM: IMG/VR / Nayfach 2021 defaults)
    coverm_min_covered_fraction = 0.70
    coverm_min_read_pid         = 0.95

    // Databases (set explicitly per environment)
    genomad_db      = null
    checkv_db       = null
    phabox_db       = null   // PhaBOX2 DB dir for Stage 5 LIFESTYLE (PhaTYP); optional
    iphop_db        = null   // iPHoP DB dir for Stage 4b HOST_IPHOP; optional (stock or add_to_db-augmented)

    // Stage 5 (SUMMARIZE): external DRAM-v (tpall/DRAM -r dev --use_dramv) AMG
    // outputs, joined to the quantification. Either point --dramv2_outdir at the
    // DRAM-v run dir, or override the two tables directly. SUMMARIZE skips
    // gracefully (warning, no failure) when these are unset/absent, so discovery
    // can run first and a `-resume` pass after DRAM-v fires the AMG summary.
    dramv2_outdir      = null
    dramv2_annotations = null
    dramv2_summary     = null

    // Skip Stage 4 (HOST_COUPLE) entirely — useful for smoke tests where
    // the samplesheet's bins_dir points at a project-wide directory with
    // thousands of MAGs, fanning out one MINCED task per bin.
    skip_host_couple = false

    // Resource ceilings (machine-wide; override per profile)
    max_cpus        = 32
    max_memory      = '256.GB'
    max_time        = '72.h'

    // SLURM job-array submission for heavy per-sample stages (GENOMAD,
    // CHECKV, COVERM). Submitting one array of N tasks counts as one job
    // for fair-share priority instead of N individual sbatches. Set to 0
    // to disable (e.g. when running locally). Note: see Nextflow #6108
    // for an intermittent ConcurrentModificationException race when array
    // is combined with Singularity — recoverable with -resume.
    array_size      = 0
    queue_size      = 100
}

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${env('HOME')}/.singularity_cache"
        // Override singularity.runOptions to bind extra host paths if your
        // databases or input fastas live outside the launch dir / work dir.
        // e.g. -B /gpfs/helios -B /gpfs/space on the HPC.
        docker.enabled         = false
        podman.enabled         = false
    }
}

process {
    // Retry only on transient/resource failures (OOM, timeout, signal kills).
    // Code-bug exits fail fast.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = 8.GB
    time   = 4.h
}
